NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/sbo_printing_system
CLIENT_URL=http://localhost:5173
JWT_SECRET=dev-only-jwt-secret-change-in-production-32chars!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Google OAuth — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# reCAPTCHA v2/v3 — get from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
# REDIS_URL=redis://localhost:6379  # for rate-limit RedisStore in production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Google Drive - choose ONE quota path for folder 1IceTcwyPoV8qIgZmT7qDzWPDS5CT-PLp:
# A) My Drive (personal Gmail): set these 3 to upload as owner (uses your 15GB). Run: npm run drive:auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# B) Shared Drive (Workspace): keep service account, move folder into Shared Drive and share with service account as Manager
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_ROOT_FOLDER_ID=1IceTcwyPoV8qIgZmT7qDzWPDS5CT-PLp
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
